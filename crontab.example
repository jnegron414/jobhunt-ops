30 7 * * 1-5  cd ~/jobhunt-ops && .venv/bin/python scripts/scrape_boards.py && .venv/bin/python scripts/digest.py
# Friday 4pm: weekly funnel review written into the digests folder
0 16 * * 5  cd ~/jobhunt-ops && .venv/bin/python scripts/tracker.py stats > ~/jobhunt-data/output/digests/$(date +\%Y-\%m-\%d)-stats.md 2>&1
